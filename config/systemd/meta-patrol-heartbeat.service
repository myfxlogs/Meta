# 巡检心跳注入件（票0030）：systemd timer 外源拍——网内零 cron 戒不破。
# 装件（业主动作，非席位）：
#   ln -s /opt/meta/config/systemd/meta-patrol-heartbeat.{service,timer} \
#         ~/.config/systemd/user/ && systemctl --user daemon-reload \
#     && systemctl --user enable --now meta-patrol-heartbeat.timer
[Unit]
Description=meta patrol heartbeat event inject

[Service]
Type=oneshot
ExecStart=/opt/meta/bin/meta inject --socket /opt/meta/run/meta.sock \
  --kind patrol_tick --actor systemd:meta-patrol-heartbeat.timer \
  --note "静默期心跳拍"
