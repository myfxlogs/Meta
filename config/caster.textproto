# 播报员路由表（令#E13/D-26）：事件→动作电话簿；表外事件不处置只按种子通知（铁律②）。
# 改表走票；部署同步 /opt/meta/config/。模板相对本文件目录（配置根）解。
# 通知格式＝令决策41：【Meta】角色:动作[票号]——模板不写死角色处用 {{role}}（事件自带）。
# 改表规程（票0021 钦定）：改表 → systemctl --user restart meta-caster（载新表）
#   → meta reconcile --socket /opt/meta/run/meta.sock（滞留票补发）——
#   对账函数事件触发一次性扫表，幂等可重跑。

routes {
  kind: "stall_suspect"
  note: "疑似卡死→通知+派 CTO 裁决席（清 D-16）"
  actions { notify  { template: "【Meta】⚠️{{role}}:疑似卡死[{{ticket_id}}]——裁决席已拉起" } }
  actions { dispatch { role: "CTO" adjunct: true
                       prompt_template: "caster/stall-ruling.md"
                       work_dir: "/opt/meta" } }
}
routes {
  kind: "budget_frozen"
  note: "票级硬顶止血→通知；CEO 面预留（阶段 3 加 dispatch role=CEO）"
  actions { notify  { template: "【Meta】⚠️预算冻结[{{ticket_id}}]——CEO 已接手" } }
}
routes {
  kind: "reject_limit"
  note: "驳回达 3→通知；同上预留 CEO 面"
  actions { notify  { template: "【Meta】⚠️连驳三次[{{ticket_id}}]——CEO 已接手" } }
}
routes { kind: "blocked" note: "失败表到限→人工态（V5：同票同原因恰一条）"
  actions { notify { template: "【Meta】⛔票 blocked[{{ticket_id}}]——{{note}}（放行:meta resume/重试/作废:meta rule void）" } } }
routes { kind: "defer_limit" note: "延期帽尽→通知" actions { notify { template: "【Meta】⚠️卡死裁决延期已尽[{{ticket_id}}]——CEO 已接手" } } }
# ——审计派发径（决策40，设计 §15 落点）——
# D-39：deliver 按事件 role 拆行——CTO 交设计票只通知（事后验归 CEO，决策49/53），
# 施工交付才派审计；审计 dispatch 行带静态模板（注入机未开期第二道防线，0007 空提示正解 D-40）。
routes { kind: "deliver" role: "CTO"
  note: "设计票交付→只通知不进审（CTO 交付归 CEO 事后验，决策49/53）"
  actions { notify { template: "【Meta】{{role}}:设计交付·事后验[{{ticket_id}}]" } } }
routes { kind: "deliver" role: "施工"
  note: "施工交付→通知＋起审计席（决策53 复位：全链无人；票面必带 spec 防 D-40 空提示）"
  actions { notify { template: "【Meta】{{role}}:完工转交[{{ticket_id}}]" } }
  actions { dispatch { role: "审计" prefer_shell: "devin" work_dir: "/opt/meta"
                       prompt_template: "caster/audit-review.md" } } }
routes { kind: "audit_start" note: "审计拉起（决策34 缺口补）" actions { notify { template: "【Meta】审计:接单[{{ticket_id}}]" } } }
routes { kind: "audit_pass" note: "判决通过→待部署＋派 CTO-B 部署席（票0010：闭环最后一只手；T26：CliDrive 钦定径）"
  actions { notify { template: "【Meta】审计:完成转交[{{ticket_id}}]" } }
  actions { dispatch { role: "CTO" work_dir: "/opt/meta" cli_drive: true
                       prompt_template: "caster/cto-deploy.md" } } }
routes { kind: "deploy_start" note: "部署席领票步行（部署中）" actions { notify { template: "【Meta】CTO:部署开工[{{ticket_id}}]" } } }
routes { kind: "deploy_failed" note: "部署失败已回滚→待部署＋CEO 裁（重试/作废）" actions { notify { template: "【Meta】⚠️CTO:部署失败[{{ticket_id}}]——已回滚待裁" } } }
routes { kind: "deploy_done" note: "部署完成（闭环终态）" actions { notify { template: "【Meta】CTO:部署完成[{{ticket_id}}]" } } }
routes { kind: "reject" note: "驳回→通知＋自动重派施工（判决史随注入累积）"
  actions { notify { template: "【Meta】审计:驳回转交[{{ticket_id}}]" } }
  actions { dispatch { role: "施工" work_dir: "/opt/meta" prompt_template: "caster/build-seat.md" } } }
routes { kind: "audit_dead" note: "审计席死→通知＋重起审计（不计驳回）"
  actions { notify { template: "【Meta】⚠️审计席中断[{{ticket_id}}]——自动重派中" } }
  actions { dispatch { role: "审计" prefer_shell: "devin" work_dir: "/opt/meta" prompt_template: "caster/audit-review.md" } } }
# ——飞书通道知行（票0013 通知面；dispatch CEO 行不写——消费径走 CeoGateway 泵/通道自身出站）——
routes { kind: "feishu_cred_bad" note: "凭证行缺/坏→通道不启（fail loud；需业主重打包 secret.feishu.app）"
  actions { notify { template: "【Meta】⚠️飞书凭证坏：通道未起——需重打包 secret.feishu.app" } } }
routes { kind: "feishu_inbound" note: "飞书业主来话入泵（通道已发机械回执，此为文本兜底）"
  actions { notify { template: "【Meta】飞书:来话入泵——{{note}}" } } }
routes { kind: "ceo_say" note: "CEO 出站（通道发 owner chat，此为文本兜底与历史流）"
  actions { notify { template: "【Meta】CEO说：{{note}}" } } }
routes { kind: "ceo_gap" note: "CEO run 收口零写（D-22 比对）"
  actions { notify { template: "【Meta】⚠️CEO收口零写：{{note}}" } } }
routes { kind: "ceo_last_resort" note: "无头唤起连败呼救（D3 径；通道亦直推 owner）"
  actions { notify { template: "【Meta】⚠️CEO呼救：{{note}}" } } }
# ——通知面（决策41 新格式）——
routes { kind: "shell_limited" note: "壳限流/日限打穿（决策17 配额面）" actions { notify { template: "【Meta】⚠️{{note}}限流打穿——今日退席，明日自愈" } } }
routes { kind: "project_set"       actions { notify { template: "【Meta】系统:项目挂接[{{ticket_id}}] {{note}}" } } }
routes { kind: "shells_exhausted"  actions { notify { template: "【Meta】⚠️全壳耗尽[{{ticket_id}}]——换班链走完仍失败" } } }
routes { kind: "ruling"            actions { notify { template: "【Meta】{{role}}:裁决完毕[{{ticket_id}}]" } } }
# ——表外兜底通知（令#E13 铁律②：表外事件只通知不处置）——
# 无路由行匹配且 kind 命中种子集→至少通知；同 resync 批 (kind,ticket) 降噪只报首枚。
# 种子集＝设计-0020 §2.1 钦定列（异常/阻塞/死类全收）——改集走票：
# spawn_blocked 钦定不入（决策75：队列内务，终态有 shells_exhausted），seat_dead 不入
# （正常交付退席同打此 kind，收则刷屏）；模板空＝缺省形【Meta】{{role}}:{{action}}[{{ticket_id}}]。
default_notify {
  kinds: "blocked"         kinds: "spawn_failed"       kinds: "spawn_dup"
  kinds: "spawnq_full"     kinds: "inject_failed"      kinds: "seat_err"
  kinds: "adjunct_dead"    kinds: "adjunct_yield"      kinds: "adopt_failed"
  kinds: "budget_reset_failed" kinds: "budget_stop"    kinds: "exec_denied"
  kinds: "shell_dead"      kinds: "shell_recovered"    kinds: "ceo_gap"
  kinds: "ceo_last_resort" kinds: "yield"              kinds: "req_pending"
  kinds: "design_dead"     kinds: "budget_warn"
}
routes { kind: "shells_degraded" note: "单壳降级换壳（T3 判决补——处置不静默 E18）" actions { notify { template: "【Meta】壳降级[{{ticket_id}}]——单壳让位换壳，不杀席" } } }
