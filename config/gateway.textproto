# 网关配置（D-9 配置出码外；帽值毛口径 D-27——0003 施工实测 20.18M 起算）
# serve --config 可覆盖路径；缺/坏拒起。部署同步 /opt/meta/config/。

progress_timeout   { seconds: 1800 }  # 30m 进度帧闹钟
auth_timeout       { seconds: 5 }
adopt_dial_timeout { seconds: 2 }
stagger            { seconds: 10 }    # ②a 限流错峰
quick_exit         { seconds: 20 }    # ①秒退判定窗
max_per_shell: 6
audit_shell_skip_streak: 2            # D-46 审计重派壳偏置：同壳连败≥2 本轮跳过
default_attempt_cap: 20000000
ticket_hard_cap:     120000000        # ≈3 施工尝试+审计+CTO 合计毛值

role_budget { role: "施工" attempt_cap: 40000000 }  # 0003 整票 20.18M×2 余量
role_budget { role: "审计" attempt_cap: 15000000 }
role_budget { role: "CTO"  attempt_cap: 15000000 }

# 壳登记表种子（角色行空才落；priority 小者优先；model 空＝壳自身缺省）
shell { name: "devin"    model: "swe-2-high" role: "施工" priority: 10 }
shell { name: "claude"   role: "施工" priority: 20 }
shell { name: "opencode" role: "施工" priority: 30 attempt_cap: 8000000 note: "每日限量低帽" }
shell { name: "claude"   role: "审计" priority: 10 note: "devin 只读形态四死弃用·决策39/40" }
shell { name: "devin"    model: "swe-2-max" role: "审计" priority: 20 }
shell { name: "opencode" role: "审计" priority: 30 attempt_cap: 8000000 }
shell { name: "devin"    model: "swe-2-max" role: "CTO" priority: 10 }
shell { name: "claude"   role: "CTO" priority: 20 }
shell { name: "opencode" role: "CTO" priority: 30 attempt_cap: 8000000 }

# 项目配方种子（票0010 部署闸）：meta 自举首个被部署项目。
# 票0029：check 步跑票代码＝不可信→docker 容器笼（metaseat 用户已删——uid 切
# 径退役）；余四步仓内固定件（git/换装/socket）→mluser 直跑零 sudoers。
project {
  id: "meta"
  repo_url: "/opt/meta"
  default_branch: "master"
  integrate_cmd: "git -C /opt/meta rev-parse --verify \"$META_EXEC_REF\" || exit 92; git -C /opt/meta merge-base --is-ancestor \"$META_EXEC_REF\" HEAD && exit 0; git -C /opt/meta -c user.name=meta -c user.email=meta@meta.local merge --no-ff \"$META_EXEC_REF\""
  check_cmd: "export PATH=/usr/local/go/bin:$PATH && go build ./... && go vet ./... && go test -count=1 ./..."
  deploy_cmd: "bash /opt/meta/scripts/meta-deploy.sh"
  probe_cmd: "bash /opt/meta/scripts/meta-probe.sh"
  # T34 §7.4：真回滚或 exit 1——MERGE_HEAD 在＝半合并 abort；HEAD 是合并提交
  # （集成已成未部署）＝reset 回合并前父；皆无＝无可回状态 exit 1（禁告警退 0）。
  rollback_cmd: "if git -C /opt/meta rev-parse -q --verify MERGE_HEAD >/dev/null; then git -C /opt/meta merge --abort && echo \"rollback: 半合并态已弃净\"; elif git -C /opt/meta rev-parse -q --verify \"HEAD^2\" >/dev/null; then git -C /opt/meta reset --hard \"HEAD^\" && echo \"rollback: 已退合并提交回原 HEAD\"; else echo \"rollback: 无可回状态（无 MERGE_HEAD、HEAD 非合并提交）\" >&2; exit 1; fi"
  # T36 §3.3-D：meta 项目自动票径切 live（径已熟，影子期只罩新接外部面）。
  auto_ticket_mode: "live"
  sandbox {
    run_as: "metaseat"
    step_run_as { key: "integrate" value: "metaseat" }
    step_run_as { key: "deploy"    value: "metaseat" }
    step_run_as { key: "probe"     value: "metaseat" }
    step_run_as { key: "rollback"  value: "metaseat" }
    step_container_image { key: "check" value: "golang:1.27" }
    exec_timeout { seconds: 900 }
  }
}

# CEO 壳行＝业主写死（§7 登记表）：落种占位 claude——动此行需业主令。
shell { name: "claude"   role: "CEO" priority: 10 note: "业主写死壳·落种占位" }

# CEO 面（票0011）：spawn_kinds＝无头化身触发集。T34 缩到两种（v2 §3.1/
# §3.3-E：化身只裁业务需求——异常处置归失败表，不再唤起 CEO）；
# ceo_events＝Events 流放行 kind 列；
# ceo_prompt＝无头席提示模板（{{kind}}/{{ticket_id}}/{{note}}/{{run_dir}}/{{gateway_sock}}）。
ceo_spawn_kinds: "feishu_inbound"
ceo_spawn_kinds: "requirement"
ceo_events: "reject_limit"
ceo_events: "budget_frozen"
ceo_events: "shells_exhausted"
ceo_events: "deploy_failed"
ceo_events: "defer_limit"
ceo_events: "feishu_inbound"
ceo_events: "requirement"
ceo_events: "ruling"
ceo_events: "ceo_say"
ceo_events: "ceo_gap"
ceo_events: "ceo_last_resort"
ceo_events: "redirect"
ceo_prompt: "config/caster/ceo-headless.md"

# 前端席位板（票0012）：loopback+token 钦定最小暴露面；仅 loopback 地址合法。
# token 种子=业主动作：meta secret put secret.board.token（值读 stdin）。
board_listen: "127.0.0.1:9712"

reconcile_debounce { seconds: 60 }         # T35 改义：幂等调和器周期（R2′ 钦定唯一周期例外）

# 失败表（v2 §3.3-B，改表走票）：kind→确定性处置＋期窗上限，超限→blocked
# （人工态一条通知）。action：next_shell/retry_same/shell_dead_next/
# kill_respawn/same_shell/rollback/freeze/blocked；"*"＝未列 kind 兜底。
failure_rule { kind: "seat_err"        action: "next_shell"      cap: 0 }  # 秒退/起不来→换下一壳（壳尽→blocked 经 shells_exhausted）
failure_rule { kind: "spawn_failed"    action: "next_shell"      cap: 0 }
# T46：seat_dead 入表——缺行则落 "*"→blocked（0050/19:44 瞬回实证径）；
# 与码内缺省同值，换壳重派期窗无帽。
failure_rule { kind: "seat_dead"       action: "next_shell"      cap: 0 }
failure_rule { kind: "shell_limited"   action: "retry_same"      cap: 3 }  # 429/5xx/连接错退避同壳≤3→换壳
failure_rule { kind: "shell_dead"      action: "shell_dead_next" cap: 0 }  # 配额尽/授权失效标死换壳
failure_rule { kind: "stall_suspect"   action: "kill_respawn"    cap: 2 }  # 进度帧超时 30min 杀+换壳重派≤2
failure_rule { kind: "stall_kill"      action: "kill_respawn"    cap: 2 }
failure_rule { kind: "clidrive_dead"   action: "next_shell"      cap: 0 }  # 连败 3 由 cliDriveSpawn 计数截断→blocked
failure_rule { kind: "reject"          action: "same_shell"      cap: 3 }  # 审计驳回同壳重做≤3
failure_rule { kind: "deploy_failed"   action: "rollback"        cap: 1 }  # 部署检查红/探针红回滚 1 次
failure_rule { kind: "budget_frozen"   action: "freeze"          cap: 0 }  # 预算到顶→冻
failure_rule { kind: "*"               action: "blocked"         cap: 0 }  # 未知错误 0 次直接 blocked

# T34：巡检席全径切除（v2 §3.1）——subscribe/filter_shell 段与巡检壳
# 登记行一并删除；DB 里既有 subscription/巡检壳行随席位退役不再被读。

# 票0033/T8 席位容器笼出闸种子（纯配置态——笼码面 0031/0032 未落 master，
# 种子随部署生效，禁即刻生效钦定径不违）：
seat_image: ""
seat_net: "meta-seat"
seat_mount_mask: "/opt/meta/run"
seat_extra_mount: "/opt/meta/run/logs:/opt/meta/run/logs:ro"
